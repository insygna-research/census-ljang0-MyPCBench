# =============================================================================
# MyPCBench runner configuration — copy to .env and fill in.
# =============================================================================
# This repo runs the benchmark against a pre-baked VM image, so the only
# required values are API keys. Persona/seed/data are already baked into the
# image (the generator + image bake are not part of this public release).

# --- API keys (required to run agents + grade) ------------------------------
ANTHROPIC_API_KEY=     # Claude agents (claude-opus-4-6, claude-sonnet-4-6)
OPENAI_API_KEY=        # GPT agents (gpt-5.5, gpt-5.4-mini) + NPC auto-replies
GEMINI_API_KEY=        # Rubric judge (judge_results.py, gemini-3.1-flash-lite-preview)

# --- VM image ---------------------------------------------------------------
# No-docker (default backend): get-eval-image.sh writes these into env.sh.
# Leave these commented unless you want to hardcode a local VM path here;
# blank assignments would override values exported by mypcbench-vm/env.sh.
# MYPCBENCH_QCOW2=                 # base qcow2 path (or pass --qcow2_path)
# MYPCBENCH_OVMF_CODE=             # OVMF firmware (auto-detected if unset)
# MYPCBENCH_OVMF_VARS=
# Docker backend: the image is selected with the runner's --docker_image
# flag. Default is ljang/mypcbench-qemu:latest, which tracks the current
# current daily image.
# No env var controls it.

# In-VM NPC auto-replies use OPENAI_API_KEY (injected by the runner). The
# optional in-guest LLM_BASE_URL/LLM_MODEL overrides are container-level
# settings, not read from this file.
